# Official public endpoint. It is rate-limited and pruned. Use an archive endpoint for pinned proposal fork tests and
# a dedicated provider for production submission.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Private key for the gas-funded EOA that broadcasts DeployContracts.s.sol. Never commit a populated .env file.
DEPLOYER_PRIVATE_KEY=
